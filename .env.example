# 留空关闭密码登录；也可以直接修改 compose.yaml 的 environment。
LUMA_ACCESS_PASSWORD=
LUMA_PORT=4173
LUMA_BIND_ADDRESS=127.0.0.1
# 反向代理使用 HTTPS 时填写，例如 https://gallery.example.com
PUBLIC_ORIGIN=
# 自定义数据源地址时取消下面注释；放行内网地址需同步设置 LUMA_ALLOWED_ORIGINS。
# LUMA_SOURCE_SHIGUANG_URL=http://host.docker.internal:4180/
# LUMA_SOURCE_SHIJING_URL=http://host.docker.internal:4182/
